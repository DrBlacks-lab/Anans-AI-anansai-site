      "roles": ["admin", "guest"],
      "authority_source": "Railway environment-backed credentials and signed role/version session",
      "side_effect_class": "session_only",
      "terminal_outcomes": ["authenticated", "rejected", "rate_limited", "expired_or_revoked"],
      "receipt_surface": "runtime/deployment logs; no durable per-login ledger implemented",
      "failure_conditions": ["missing required environment variables", "bad credential", "disabled/expired guest", "session-version mismatch", "invalid/tampered/expired cookie"]
    },
